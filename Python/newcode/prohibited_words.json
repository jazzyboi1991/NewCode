{
    "schema_version": "1.1",
    "language_version": "0.1",
    "purpose": "Official Newcode censorship lexicon. Source programs cannot modify this file.",
    "normalization": {
        "case_sensitive": false,
        "collapse_whitespace": true,
        "remove_separators": ["-", "_", ".", " ", "\t", "\n"],
        "leet_substitutions": {
            "0": "o",
            "1": "i",
            "3": "e",
            "4": "a",
            "5": "s",
            "7": "t",
            "@": "a",
            "$": "s"
        }
    },
    "matching": {
        "text_and_input": "whole_word_or_phrase",
        "identifiers": "normalized_substring",
        "recheck_after_join": true
    },
    "morphology_rules": {
        "purpose": "Permit a small, regular Newspeak vocabulary instead of a large family of near-synonyms.",
        "prefixes": [
            {
                "prefix": "un",
                "allowed_bases": ["good", "goodthink", "goodparty"],
                "meaning": "approved negation",
                "examples": ["ungood", "ungoodthink", "ungoodparty"]
            },
            {
                "prefix": "plus",
                "allowed_bases": ["good", "ungood", "goodthink", "goodparty"],
                "meaning": "approved intensifier",
                "examples": ["plusgood", "plusungood", "plusgoodthink", "plusgoodparty"]
            },
            {
                "prefix": "doubleplus",
                "allowed_bases": ["good", "ungood", "goodthink", "goodparty"],
                "meaning": "maximum approved intensifier",
                "examples": ["doubleplusgood", "doubleplusungood", "doubleplusgoodthink", "doubleplusgoodparty"]
            },
            {
                "prefix": "old",
                "allowed_bases": ["think", "speak"],
                "meaning": "obsolete or ideologically suspect form",
                "examples": ["oldthink", "oldspeak"]
            }
        ],
        "compounds": [
            {
                "root": "think",
                "allowed_qualifiers": ["good", "ungood", "plusgood", "doubleplusgood", "old"],
                "meaning": "quality of thought"
            },
            {
                "root": "party",
                "allowed_qualifiers": ["good", "ungood", "plusgood", "doubleplusgood"],
                "meaning": "degree of Party alignment"
            },
            {
                "root": "life",
                "fixed_forms": ["ownlife"],
                "meaning": "a denunciatory label for private individuality"
            },
            {
                "root": "speak",
                "fixed_forms": ["oldspeak", "duckspeak"],
                "meaning": "obsolete or unreflective speech"
            }
        ],
        "inflections": {
            "allowed": ["plural_s", "past_ed", "present_participle_ing", "agent_er"],
            "policy": "Apply only to approved roots and approved compound forms. Irregular forms require an explicit replacement rule."
        },
        "function_word_reductions": [
            {
                "terms": ["although", "however", "nevertheless", "despite"],
                "replacement": "but",
                "purpose": "remove elaborate concession and contrast"
            },
            {
                "terms": ["therefore", "consequently", "thus"],
                "replacement": "so",
                "purpose": "compress causal explanation"
            },
            {
                "terms": ["moreover", "furthermore", "additionally"],
                "replacement": "and",
                "purpose": "compress elaboration"
            },
            {
                "terms": ["perhaps", "possibly", "maybe"],
                "replacement": "ungoodthink",
                "purpose": "deny hedging and unapproved uncertainty"
            }
        ],
        "prohibited_productivity": [
            "Do not invent a new abstract noun merely by adding -ness, -ity, -tion, -ism, or -ship.",
            "Do not create a new antonym with a prefix other than un-.",
            "Do not create a new intensifier with a prefix other than plus- or doubleplus-."
        ]
    },
