// 반환값을 가지는 routine 두 개를 정의하는 예제입니다.
newcode 0.1

// 두 numberthink 매개변수를 더해 numberthink 값을 반환하는 routine입니다.
routine numberthink addgood(numberthink first, numberthink second)
    // first와 second의 합을 호출자에게 돌려줍니다.
    reportvalue first plus second
// addgood routine의 정의를 끝냅니다.
endroutine

// 두 wordthink 매개변수를 이어 wordthink 값을 반환하는 routine입니다.
routine wordthink makeword(wordthink left, wordthink right)
    // left와 right를 연결한 문자열을 반환합니다.
    reportvalue left join right
// makeword routine의 정의를 끝냅니다.
endroutine

// addgood을 호출한 결과 15를 total에 저장합니다.
thought numberthink total be addgood(7, 8)
// makeword를 호출해 하나의 문자열을 label에 저장합니다.
thought wordthink label be makeword("routine ", "approved")

// routine이 만든 문자열을 출력합니다.
speak label
// routine의 숫자 반환값을 출력합니다.
speak "total: ", total
