// 문자열 결합 예제입니다.
newcode 0.1

// 첫 번째 문자열 조각을 저장합니다.
thought wordthink first be "New"
// 두 번째 문자열 조각을 저장합니다.
thought wordthink second be "code"
// 두 문자열과 뒤의 문구를 join으로 이어 label을 만듭니다.
thought wordthink label be first join second join " grammar"

// 완성된 문자열을 출력합니다.
speak label
// 문자열 출력이 여러 번 가능하다는 것을 보여 줍니다.
speak "joined text is checked again"
