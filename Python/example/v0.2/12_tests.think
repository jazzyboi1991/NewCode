// testthink 문법을 사용하는 0.2 테스트 프로그램입니다.
newcode 0.2

// addition이라는 이름의 독립 테스트 블록을 시작합니다.
testthink "addition"
    // 2와 3의 합이 5인지 검증합니다.
    verify 2 plus 3 same 5
        // 검증이 성공하면 승인 메시지를 출력합니다.
        speak "approved"
    // 검증이 실패했을 때 실행할 대체 분기입니다.
    otherthink
        // 테스트 실패 메시지를 출력합니다.
        speak "failed"
    // verify 블록을 닫습니다.
    endverify
// testthink 블록을 닫습니다.
endtestthink
