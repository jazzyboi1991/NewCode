// 반복문과 nextrepeat/stoprepeat 제어 예제입니다.
newcode 0.1

// 반복 횟수를 세기 위한 변수를 0으로 시작합니다.
thought numberthink count be 0
// 누적 합계도 0으로 시작합니다.
thought numberthink total be 0

// count가 6보다 작은 동안 반복합니다.
repeatwhile count less 6
    // 현재 count가 2인지 검사해 건너뛸지 결정합니다.
    thought goodthink skip be count same 2
    // 다음 반복을 위해 count를 1 증가시킵니다.
    thought count be count plus 1

    // skip이 참이면 이번 반복의 남은 내용을 건너뜁니다.
    verify skip
        // 반복문의 다음 차례로 즉시 이동합니다.
        nextrepeat
    // skip 조건 블록을 닫습니다.
    endverify

    // 현재 count를 total에 누적합니다.
    thought total be total plus count

    // count가 5가 되면 반복을 종료합니다.
    verify count same 5
        // 가장 가까운 repeatwhile을 끝냅니다.
        stoprepeat
    // 종료 조건 블록을 닫습니다.
    endverify
// 반복문을 닫습니다.
endrepeat

// 최종 count 값을 출력합니다.
speak "count: ", count
// 건너뛴 차례를 반영한 누적 total을 출력합니다.
speak "total: ", total
