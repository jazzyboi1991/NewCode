// 여러 기능을 함께 사용하는 기본 성공 예제입니다.
newcode 0.1

// 두 숫자를 더해 반환하는 routine을 정의합니다.
routine numberthink addgood(numberthink first, numberthink second)
    // 두 매개변수의 합을 반환합니다.
    reportvalue first plus second
// routine 정의를 끝냅니다.
endroutine

// count에 시작 숫자 3을 저장합니다.
thought numberthink count be 3
// 1을 3으로 나눈 소수를 share에 저장합니다.
thought numberthink share be 1 divide 3
// count가 0보다 큰지 검사한 결과를 approved에 저장합니다.
thought goodthink approved be count more 0

// approved가 참이면 성공 분기를 실행합니다.
verify approved
    // count에 1을 더한 결과와 설명을 출력합니다.
    speak "Victory count: ", addgood(count, 1)
    // share를 소수 둘째 자리까지 반올림해 출력합니다.
    speak "Share: ", share to 2
// approved가 거짓일 때 실행할 대체 분기입니다.
otherthink
    // 조건이 거짓일 때의 메시지를 출력합니다.
    speak "Ungood."
// 조건 분기를 끝냅니다.
endverify
